{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "调试 实验一 (lab1 · STM32F103C8)",
      "type": "cortex-debug",
      "request": "launch",
      "servertype": "openocd",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/build/lab1.elf",
      "device": "STM32F103C8",
      "interface": "swd",
      "gdbPath": "/usr/bin/gdb-multiarch",
      "runToEntryPoint": "main",
      "preLaunchTask": "Build: 实验一 (lab1 · F103C8)",
      "configFiles": [
        "interface/stlink.cfg",
        "target/stm32f1x.cfg"
      ],
      "showDevDebugOutput": "none"
    },
    {
      "name": "调试 实验二 (lab2 · STM32F103C8)",
